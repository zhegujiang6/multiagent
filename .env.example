# ============================================
# LLM Configuration
# ============================================
# LLM (OpenAI compatible)
LLM_API_KEY=your_llm_api_key
LLM_API_BASE=https://your-openai-compatible-endpoint/v1
LLM_MODEL=qwen-max
LLM_FAST_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048


# ============================================
# Database
# ============================================
DATABASE_URL=postgresql+asyncpg://cs_admin:cs_secret_2024@localhost:5432/customer_service
DATABASE_URL_SYNC=postgresql://cs_admin:cs_secret_2024@localhost:5432/customer_service

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Java Ticket Service
# ============================================
TICKET_SERVICE_URL=http://localhost:8080
TICKET_SERVICE_TIMEOUT_SECONDS=5
TICKET_DATABASE_URL=jdbc:postgresql://localhost:5432/customer_service
TICKET_DATABASE_USERNAME=cs_admin
TICKET_DATABASE_PASSWORD=cs_secret_2024

# ============================================
# RocketMQ Ticket Events
# ============================================
ROCKETMQ_ENABLED=false
ROCKETMQ_CONSUMER_ENABLED=false
ROCKETMQ_NAME_SERVER=localhost:9876
ROCKETMQ_PRODUCER_GROUP=ticket-service-producer
ROCKETMQ_CONSUMER_GROUP=python-ticket-event-consumer

# ============================================
# Qdrant
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================
# Embedding Model
# ============================================
# Embedding
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_API_BASE=https://your-openai-compatible-endpoint/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# ============================================
# App Settings
# ============================================
APP_NAME=Customer Service Agent
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
WS_HEARTBEAT_INTERVAL=30

